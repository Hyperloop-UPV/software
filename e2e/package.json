{
  "name": "e2e",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-renderers.mjs",
    "test": "pnpm run build && playwright test",
    "test:ui": "pnpm run build && playwright test tests/ui",
    "test:integration": "pnpm run build && playwright test --project=integration",
    "test:fast": "playwright test",
    "test:fast:ui": "playwright test tests/ui",
    "test:fast:integration": "playwright test --project=integration",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "electron": "^40.1.0"
  }
}
