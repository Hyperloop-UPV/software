{
  "name": "@hyperloop-upv/frontend-kit",
  "version": "0.1.0",
  "description": "Shared React + Tailwind component kit and WebSocket layer for Hyperloop UPV frontends",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hyperloop-UPV/software.git",
    "directory": "frontend/frontend-kit/kit"
  },
  "homepage": "https://github.com/Hyperloop-UPV/software/tree/develop/frontend/frontend-kit/kit",
  "bugs": {
    "url": "https://github.com/Hyperloop-UPV/software/issues"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "src",
    "postcss.config.mjs",
    "components.json",
    "README.md"
  ],
  "scripts": {
    "build": "vite build",
    "lint": "eslint .",
    "icon:add": "icons-master add",
    "icon:remove": "icons-master remove"
  },
  "peerDependencies": {
    "lucide-react": ">=0.500.0 <1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.1.0",
    "tw-animate-css": "^1.4.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "radix-ui": "^1.4.3",
    "react-resizable-panels": "^4.6.0",
    "rxjs": "^7.8.2",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@hyperloop-upv/eslint-config": "workspace:*",
    "@hyperloop-upv/typescript-config": "workspace:*",
    "@maximka76667/icons-master": "^1.0.3",
    "@tailwindcss/postcss": "^4.1.18",
    "@turbo/gen": "^2.8.3",
    "@types/node": "^25.2.0",
    "@types/react": "^19.2.11",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^4.2.3",
    "eslint": "^9.39.2",
    "lucide-react": "^0.563.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwindcss": "^4.1.18",
    "tinyglobby": "^0.2.17",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-dts": "^5.1.2"
  },
  "exports": {
    ".": "./src/index.ts",
    "./core": "./src/core/index.ts",
    "./globals.css": "./src/styles/globals.css",
    "./postcss.config": "./postcss.config.mjs",
    "./lib": "./src/lib/index.ts",
    "./components": "./src/components/index.ts",
    "./hooks": "./src/hooks/index.ts",
    "./lib/*": "./src/lib/*.ts",
    "./components/*": "./src/components/*.tsx",
    "./hooks/*": "./src/hooks/*.ts",
    "./store": "./src/store/index.ts",
    "./icons": "./src/icons/index.ts",
    "./outreach/*": "./src/outreach/*",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./core": {
        "types": "./dist/core/index.d.ts",
        "default": "./dist/core/index.js"
      },
      "./globals.css": "./src/styles/globals.css",
      "./postcss.config": "./postcss.config.mjs",
      "./lib": {
        "types": "./dist/lib/index.d.ts",
        "default": "./dist/lib/index.js"
      },
      "./components": {
        "types": "./dist/components/index.d.ts",
        "default": "./dist/components/index.js"
      },
      "./hooks": {
        "types": "./dist/hooks/index.d.ts",
        "default": "./dist/hooks/index.js"
      },
      "./icons": {
        "types": "./dist/icons/index.d.ts",
        "default": "./dist/icons/index.js"
      },
      "./lib/*": {
        "types": "./dist/lib/*.d.ts",
        "default": "./dist/lib/*.js"
      },
      "./components/*": {
        "types": "./dist/components/*.d.ts",
        "default": "./dist/components/*.js"
      },
      "./hooks/*": {
        "types": "./dist/hooks/*.d.ts",
        "default": "./dist/hooks/*.js"
      },
      "./outreach/*": "./src/outreach/*",
      "./package.json": "./package.json"
    }
  }
}
