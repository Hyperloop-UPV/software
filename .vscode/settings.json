{
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.organizeImports": "explicit"
  },

  // JSON files
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },

  // TypeScript/JavaScript files
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },

  // CSS/SCSS files
  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },

  // Go files
  "[go]": {
    "editor.defaultFormatter": "golang.go"
  },

  // Go settings
  "go.lintTool": "staticcheck", // Use staticcheck as linter
  "go.lintOnSave": "package", // Lint on save: "off", "package", or "workspace"
  "go.lintFlags": ["-checks=all"], // Which checks to run

  // Prettier settings
  "prettier.useEditorConfig": false,

  // Rust settings
  "[rust]": {
    "editor.defaultFormatter": "rust-lang.rust-analyzer",
    "editor.codeActionsOnSave": {
      "source.fixAll.rust-analyzer": "explicit"
    }
  },
  "rust-analyzer.linkedProjects": ["backend/Cargo.toml"],
  "rust-analyzer.check.command": "clippy",
  "rust-analyzer.check.extraArgs": ["--all-targets"],

  // ESLint: each frontend/* package has its own flat eslint.config.js
  "eslint.workingDirectories": [{ "mode": "auto" }],

  // Python: blcu-programming is the only Python project, venv created by
  // its postinstall script (blcu-programming/scripts/setup.mjs)
  "python.defaultInterpreterPath": "${workspaceFolder}/blcu-programming/.venv/bin/python",

  // Keep VS Code from indexing/watching generated and vendored trees
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/target/**": true,
    "**/dist/**": true,
    "**/.venv/**": true,
    "**/.venv-build/**": true,
    "**/.turbo/**": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/target": true,
    "**/dist": true,
    "**/.venv": true,
    "**/.venv-build": true,
    "**/.turbo": true
  }
}
